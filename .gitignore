# Python
__pycache__/
*.py[cod]
*.egg-info/
.Python

# Virtualenv
venv/
.venv/

# Environment — never commit real secrets (CLAUDE.md §16)
.env

# Test / coverage artefacts
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# macOS
.DS_Store

# Node. Two separate package.json files, for two separate reasons:
#   - the root one is deploy tooling only (Phase 18): the `railway` package evaluates
#     .railway/railway.ts for `railway config plan/apply`. Nothing in it is served.
#   - frontend/ is the application's frontend (Phase 23, CLAUDE.md §2), built by Vite.
# Railpack still detects Python first (pyproject.toml wins); railpack.json adds Node to
# that build and runs the frontend build inside it.
node_modules/

# Vite build output (Phase 23). `npm run build` in frontend/ writes it into app/static/, inside
# the package, so the wheel still ships one artefact (CLAUDE.md §2). Build output, never source:
# the source is frontend/, and the fonts and photograph live in frontend/public/.
app/static/

# Generated from the committed frontend/src/api/openapi.json on every dev, build and test run
# (`npm run api:types`), so it can never disagree with the snapshot it came from.
frontend/src/api/schema.d.ts

# Playwright's per-run output.
frontend/test-results/
frontend/playwright-report/

# Real bank statements -- account numbers, counterparty names, and a month of real
# transactions. The parser's test fixture is a synthetic file under tests/, never this.
bank_statements/
