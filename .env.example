# Copy to .env and fill in. Never commit .env (CLAUDE.md §16).

ENV=dev

# --- Database ---------------------------------------------------------------
# Local development points at the Docker Postgres in docker-compose.yml.
DATABASE_URL=postgresql+psycopg://hisahab:hisahab@localhost:5433/hisahab
TEST_DATABASE_URL=postgresql+psycopg://hisahab:hisahab@localhost:5433/hisahab_test

# NOTE for when this moves to Supabase:
# Alembic MUST use the direct connection (port 5432), NOT the transaction pooler
# (port 6543). Pooled connections break DDL and prepared statements, so migrations
# fail in confusing, intermittent ways. The app itself may use the pooler.

# --- Supabase (unused in Phase 1; declared here as the full env surface) -----
SUPABASE_URL=
# Server-side only. Full database access -- never send this to a browser.
SUPABASE_SERVICE_KEY=
# PUBLIC BY DESIGN (Phase 12). Meant to ship in a browser; GET /api/v1/auth-config
# serves it unauthenticated so the login screen can reach Supabase at all.
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=receipts

# --- Multi-tenancy ----------------------------------------------------------
# The single outlet seeded by migration 0001. Fixed so dev, test and prod match.
DEFAULT_OUTLET_ID=00000000-0000-0000-0000-000000000001
DEFAULT_OUTLET_NAME=Main Outlet

# --- Business rules ---------------------------------------------------------
# §6.7 -- flag for a manager's eyes.
EXPENSE_REVIEW_THRESHOLD=1000.00
# §6.11 -- demand a receipt. A DIFFERENT dial from the line above on purpose: "look at
# this" and "prove this" are different questions. Never fold them into one value.
EXPENSE_RECEIPT_THRESHOLD=5000.00
MAX_UPLOAD_BYTES=5242880
MAX_FLOW_RATE_LPM=60
SIGNED_URL_TTL_SECONDS=300

# --- Web --------------------------------------------------------------------
# Comma-separated. NEVER "*" (CLAUDE.md §9) — config load will reject it.
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
TZ_DISPLAY=Asia/Kolkata
