# Copy to .env and fill in. Never commit .env (CLAUDE.md §16).

ENV=dev

# --- Database ---------------------------------------------------------------
# Local development points at the Docker Postgres in docker-compose.yml.
DATABASE_URL=postgresql+psycopg://hisahab:hisahab@localhost:5433/hisahab
TEST_DATABASE_URL=postgresql+psycopg://hisahab:hisahab@localhost:5433/hisahab_test

# Production runs on Supabase, and the note below is now live rather than advisory:
# Alembic MUST use the direct connection (port 5432), NOT the transaction pooler
# (port 6543). Pooled connections break DDL and prepared statements, so migrations
# fail in confusing, intermittent ways. The app itself may use the pooler.
#
# Which is exactly the split production runs: DATABASE_URL is the pooler, and
# MIGRATION_DATABASE_URL below is the direct URL that Alembic uses instead.

# Deploy-only, and OPTIONAL. Read by scripts/migrate.sh, never by app/core/config.py --
# no application code consumes it, so it is not a Settings field. Set it in production
# ONLY IF DATABASE_URL points at the transaction pooler; it must then be the direct URL,
# for the reason stated immediately above. Left blank here because local development
# uses one URL for both, which is what the fallback in migrate.sh is for.
MIGRATION_DATABASE_URL=

# --- Supabase (unused in Phase 1; declared here as the full env surface) -----
SUPABASE_URL=
# Server-side only. Full database access -- never send this to a browser.
# REQUIRED when ENV=prod (Phase 14). Two consumers, and both degrade SILENTLY without it:
# Storage falls back to a local temp directory, and the Auth admin client falls back to an
# in-memory double that cannot create a real account. Fine for dev, wrong for production.
SUPABASE_SERVICE_KEY=
# PUBLIC BY DESIGN (Phase 12). Meant to ship in a browser; GET /api/v1/auth-config
# serves it unauthenticated so the login screen can reach Supabase at all.
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=receipts

# --- Multi-tenancy ----------------------------------------------------------
# The single outlet seeded by migration 0001. Fixed so dev, test and prod match.
DEFAULT_OUTLET_ID=00000000-0000-0000-0000-000000000001
DEFAULT_OUTLET_NAME=Main Outlet

# --- Business rules ---------------------------------------------------------
# §6.7 -- flag for a manager's eyes.
EXPENSE_REVIEW_THRESHOLD=1000.00
# §6.11 -- demand a receipt. A DIFFERENT dial from the line above on purpose: "look at
# this" and "prove this" are different questions. Never fold them into one value.
EXPENSE_RECEIPT_THRESHOLD=5000.00
# §13.23 (Phase 13) -- a THIRD dial, separate for the same reason the two above are separate
# from each other: those ask about one expense, this asks whether a whole day's cash
# reconciled. Served by GET /client-config so the screen flags the same days the server does.
# THE FIGURE IS A GUESS and is live on real money -- see §14's open questions.
VARIANCE_ALERT_THRESHOLD=100.00
MAX_UPLOAD_BYTES=5242880
MAX_FLOW_RATE_LPM=60
SIGNED_URL_TTL_SECONDS=300

# --- Web --------------------------------------------------------------------
# Comma-separated. NEVER "*" (CLAUDE.md §9) — config load will reject it.
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
TZ_DISPLAY=Asia/Kolkata
